# =====================================================================
# RadarMind · configuração para o site online (produção)
# Copie para ".env" no servidor (ou cole cada linha no painel de variáveis
# da hospedagem) e preencha o que estiver entre < >.
# Nunca envie o .env de verdade para o GitHub.
# =====================================================================

APP_NAME=RadarMind
APP_ENV=production
# Gere uma chave NOVA para o site (não use a do seu computador):
#   php artisan key:generate --show
APP_KEY=<cole aqui a chave gerada, começa com base64:>
# false: o visitante nunca vê detalhes de erro (senhas, caminhos, SQL)
APP_DEBUG=false
# Endereço do site, com https e sem barra no final
APP_URL=https://<seu-dominio>

# Igual ao local: as mensagens do sistema já são escritas em português no código
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Só registra erros (o modo debug grava tudo e enche o disco)
LOG_LEVEL=error

# Banco MySQL da hospedagem (os dados aparecem no painel dela)
DB_CONNECTION=mysql
DB_HOST=<host do MySQL>
DB_PORT=3306
DB_DATABASE=<nome do banco>
DB_USERNAME=<usuário do banco>
DB_PASSWORD=<senha do banco>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie de login só trafega por https
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# Senhas das contas criadas pela seed. Só são usadas se você rodar
# "php artisan db:seed" no servidor; depois disso podem ser apagadas daqui.
SEED_SENHA_MATRIZ=
SEED_SENHA_SUB01=
SEED_SENHA_SUB02=
SEED_SENHA_SUB03=
SEED_SENHA_SUB04=
